{
	"schemaVersion": 1,
	"id": "conservation_table",
	"version": "${version}",
	"name": "Conservation Table",
	"description": "A player-bound item storage that keeps an exact count of every item you deposit. Right-click the table to browse your whole store in a paged grid and take back only what you put in. No conversion, no trading, no economy - just more room.",
	"authors": [
		"hhl19"
	],
	"contact": {
		"homepage": "https://github.com/summerTBD/conservation_table",
		"sources": "https://github.com/summerTBD/conservation_table"
	},
	"license": "MIT",
	"icon": "assets/conservation_table/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.hhl19.conservationtable.Conservation_table"
		],
		"client": [
			"dev.hhl19.conservationtable.client.Conservation_tableClient"
		],
		"fabric-datagen": [
			"dev.hhl19.conservationtable.client.Conservation_tableDataGenerator"
		]
	},
	"mixins": [
		"conservation_table.mixins.json",
		{
			"config": "conservation_table.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}